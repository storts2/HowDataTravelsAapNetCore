@model Student

<h1>Current Student Info</h1>
<div>Student Id: @Model.Id</div>
<div>Student Name: @Model.Name</div>
<div>Student Grade: @Model.Grade</div>

<h2>Update Student</h2>
<form asp-action="UpdateStudentWithBinding" method="post">
    <div>
        <label>Student Id</label>
        <input asp-for="Id" />
    </div>
    <div>
        <label>Student Name</label>s
        <input asp-for="Name" />
    </div>
    <div>
        <label>Student Grade</label>
        <input asp-for="Grade" />
    </div>
    <button type="submit">Update Student</button>
</form>