@model List<Student>

<h1>All the students</h1>
<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Grade</th>
            <th>Details</th>
            <th>Delete</th>
            <th>Update</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.Id</td>
                <td>@student.Name</td>
                <td>@student.Grade</td>
                <td><a asp-action="ShowDetails" asp-route-id="@student.Id">Details</a></td>
                <td><a asp-action="DeleteStudent" asp-route-id="@student.Id">Delete</a></td>
                <td><a asp-action="UpdateStudent" asp-route-id="@student.Id">Update</a></td>
            </tr>
        }
    </tbody>
</table>